{
  "name": "personal-site",
  "private": true,
  "scripts": {
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test -- --watch=false",
    "go-backend:build": "cd backend-go && go build ./cmd/api",
    "go-backend:test": "cd backend-go && go test ./...",
    "python-backend:build": "python3 -m compileall backend-python",
    "rust-backend:build": "cd backend-rust && cargo build",
    "pipeline-testing:run": "python3 -m compileall pipeline-testing"
  }
}
